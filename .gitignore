*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/

# ── Editors / OS ──────────────────────────────────────────────────────────────
.idea/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.vscode/*

# ── Backups & scratch ─────────────────────────────────────────────────────────
*.bak
*.old
err.txt
ls.txt
*.log

